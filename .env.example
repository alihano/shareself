# Copy this file to .env and fill in real values. .env is git-ignored — never
# commit a real private key or RPC URL with an embedded API key.

# Deployer wallet private key (Arc Testnet only — no mainnet/real funds).
DEPLOYER_PRIVATE_KEY=

# Arc Testnet RPC endpoint (see train.md — unverified against official docs).
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
