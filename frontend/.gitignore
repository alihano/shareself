# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is a committed placeholder template (see root
# .gitignore's same .env/.env.local-only convention), everything else is real
# deploy output and stays local.
.env
.env.local
.env*.local

# local file-based dev store (lib/messages-store.ts) — never committed, see train.md
/.data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
