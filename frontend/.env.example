# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real deployed addresses expecting secrecy isn't
# needed here (these are public contract addresses), but keep this file
# placeholder-only so a fresh clone never silently points at a stale deploy.

# Populated automatically by `npx hardhat run scripts/deploy.ts --network <net>`
# from the repo root — see scripts/deploy.ts.
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_SOCIALFI_PLATFORM_ADDRESS=
NEXT_PUBLIC_DIRECT_MESSAGING_ADDRESS=
# Block SocialFiPlatform was deployed at — event-log scans start here instead
# of block 0 (see ../train.md; scanning from genesis is what tripped Arc's
# RPC rate limit).
NEXT_PUBLIC_DEPLOY_BLOCK=

# Arc Testnet RPC endpoint — confirmed live 2026-08-25, see ../train.md.
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# WalletConnect Cloud project ID, required by RainbowKit's WalletConnect
# connector. Get one at https://cloud.reown.com (free).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# NextAuth — "Sign in with X" registration flow (see ../train.md). Generate
# NEXTAUTH_SECRET yourself, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_TWITTER_ID/SECRET come from your own X Developer Portal app
# (developer.x.com) — OAuth 2.0 Client ID/Secret, never OAuth 1.0a keys.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
